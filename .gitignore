# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.hypothesis/

# Virtual environments
.venv/
venv/
env/
ENV/

# Coverage and test artifacts
.coverage
.coverage.*
htmlcov/
coverage.xml
junit.xml

# Packaging and build output
build/
dist/
*.egg-info/
.eggs/

# Secrets and machine-local environment
.env
.env.*
!.env.example
*.pem
*.key

# Editors and operating systems
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Logs and temporary files
*.log
*.tmp
*.temp

# Reproducible per-run experiment artifacts. Keep the aggregate reports and
# summaries stored directly in each results/ directory.
agent-lab/*/experiments/results/*/
agent-lab/*/experiments/output/
